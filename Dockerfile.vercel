FROM node:22-alpine AS web-build

WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build


FROM python:3.12-slim

WORKDIR /app
ARG GROUNDBALL_SOURCE_COMMIT

COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /usr/local/bin/uv

ENV PYTHONPATH=/app/src \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    GROUNDBALL_PUBLIC_DEMO=1 \
    GROUNDBALL_RELEASE_BUNDLE=/app/release-bundle \
    GROUNDBALL_SOURCE_COMMIT=${GROUNDBALL_SOURCE_COMMIT}

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src/baseball_rag/ ./src/baseball_rag/
COPY release/bundle/ /app/release-bundle/
RUN /app/.venv/bin/python -m baseball_rag.release_bundle check /app/release-bundle \
        --expected-source-commit "${GROUNDBALL_SOURCE_COMMIT}" \
    && /app/.venv/bin/python -c 'from baseball_rag.release_runtime import release_readiness; release_readiness()' \
    && rm -f /app/src/baseball_rag/db/download.py \
        /app/src/baseball_rag/db/generate_retrosheet_team_reference.py \
        /app/src/baseball_rag/db/secondary_sources/retrosheet.py \
        /app/src/baseball_rag/db/secondary_sources/retrosheet_database.py \
        /app/src/baseball_rag/db/secondary_sources/retrosheet_events.py \
        /app/src/baseball_rag/generation/llm.py \
    && rm -rf /app/src/baseball_rag/query/catalog \
        /app/src/baseball_rag/query/coverage

COPY --from=web-build /web/dist /app/web/dist

EXPOSE 80

CMD ["sh", "-c", "exec /app/.venv/bin/python -m baseball_rag.web_app --server-name 0.0.0.0 --server-port ${PORT:-80}"]
