    {
      "identity": "batting.SLG",
      "friendly_name": "Slugging percentage",
      "aliases": ["slugging", "slugging percentage", "slg"],
      "kind": "calculation",
      "data_type": "number",
      "formula": "((H - 2B - 3B - HR) + 2*2B + 3*3B + 4*HR) / AB",
      "expression": {"op": "divide", "args": [{"op": "add", "args": [{"op": "subtract", "args": [{"field": "Batting.H"}, {"field": "Batting.2B"}, {"field": "Batting.3B"}, {"field": "Batting.HR"}]}, {"op": "multiply", "args": [{"constant": 2}, {"field": "Batting.2B"}]}, {"op": "multiply", "args": [{"constant": 3}, {"field": "Batting.3B"}]}, {"op": "multiply", "args": [{"constant": 4}, {"field": "Batting.HR"}]}]}, {"field": "Batting.AB"}]},
      "components": ["Batting.H", "Batting.2B", "Batting.3B", "Batting.HR", "Batting.AB"],
