      "aliases": ["on base percentage", "on-base percentage", "obp"],
      "kind": "calculation",
      "data_type": "number",
      "formula": "(H + BB + HBP) / (AB + BB + HBP + SF)",
      "expression": {"op": "divide", "args": [{"op": "add", "args": [{"field": "Batting.H"}, {"field": "Batting.BB"}, {"field": "Batting.HBP"}]}, {"op": "add", "args": [{"field": "Batting.AB"}, {"field": "Batting.BB"}, {"field": "Batting.HBP"}, {"field": "Batting.SF"}]}]},
